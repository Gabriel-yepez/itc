# Copiar a .env (no se sube a git) y completar.

# Dominio público que apunta (registro DNS A/AAAA) a este servidor. Caddy obtiene el certificado
# HTTPS automáticamente; los puertos 80 y 443 deben estar abiertos.
# Para probar en local: DOMINIO=localhost (certificado de una CA local de Caddy).
DOMINIO=fraude.midominio.com
ACME_EMAIL=infraestructura@midominio.com

# Genere contraseñas largas con: openssl rand -hex 32
# (hex: sin "/", "+" ni "=", que romperían la URL de conexión a PostgreSQL)
POSTGRES_PASSWORD=
# Administrador inicial de la API: solo se crea en el primer arranque (mínimo 12 caracteres).
# La app obliga a cambiarla en el primer ingreso; después borre ADMIN_CONTRASENA de este archivo.
ADMIN_USUARIO=admin
ADMIN_CONTRASENA=

# Cifrado de datos sensibles en la base (AES-256-GCM). Genere la clave con:
#   docker compose run --rm --no-deps api python -m api_fraude_detection.core.cifrado
# Guárdela también FUERA del servidor (gestor de secretos): sin ella los datos cifrados se pierden.
# Rotación: agregue una nueva al principio, separadas por comas (las anteriores siguen descifrando).
CLAVES_CIFRADO=

# Respaldos cifrados con age. Genere el par de claves EN SU EQUIPO, no en el servidor:
#   age-keygen -o clave-respaldos.txt     (la línea "public key: age1..." va aquí)
# La clave privada (clave-respaldos.txt) se guarda fuera del servidor: solo hace falta para restaurar.
RESPALDO_CLAVE_PUBLICA=

# Alertas de seguridad por webhook HTTPS (Slack, Teams, un SIEM...). Opcional.
# ALERTAS_WEBHOOK_URL=https://hooks.slack.com/services/...

# Opcionales
# POSTGRES_DB=fraude
# POSTGRES_USER=fraude
# API_PROCESOS=2
# PUERTO_HTTP=80
# PUERTO_HTTPS=443
# SUBRED_INTERNA=172.31.250.0/24
# IP_PROXY=172.31.250.10
# Límites de recursos por contenedor
# API_MEMORIA=3g
# API_CPUS=2
# WEB_MEMORIA=256m
# WEB_CPUS=1
# POSTGRES_MEMORIA=1g
# Respaldos
# RESPALDO_INTERVALO_SEGUNDOS=86400
# RESPALDO_RETENCION_DIAS=14
# RESPALDOS_DIRECTORIO=/srv/respaldos-fraude   (por defecto, un volumen de Docker)
