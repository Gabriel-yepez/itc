HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Orígenes del frontend Next.js autorizados por CORS (separados por comas)
CORS_ORIGINS=http://localhost:3000

# --- Correo saliente (avisos del formulario de contacto) ---
# Puerto 587 = STARTTLS, SMTP_SECURE=false. Puerto 465 = SMTPS, SMTP_SECURE=true.
SMTP_HOST=smtp.tuproveedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@itcservices.com
EMAIL_REPLY_TO=contacto@itcservices.com

# Buzón de reserva: recibe los avisos cuyo tipo de consulta no tenga
# destinatarios configurados en el panel. Separados por comas.
CONTACT_FALLBACK_RECIPIENTS=contacto@itcservices.com

# URL pública del panel, para el enlace "Ver la solicitud" del aviso
STRAPI_ADMIN_URL=http://localhost:1337
