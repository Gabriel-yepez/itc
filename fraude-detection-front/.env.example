# Copiar a .env.local (ignorado por git).

# URL base de la API que usa el navegador. Recomendado: mismo origen ("/api").
# Si se apunta a otro origen (https://api.midominio.com) el backend debe tener CORS para este
# origen y FRAUDE_COOKIE_DOMINIO compartido para que la cookie CSRF sea legible.
VITE_API_URL=/api

# Solo si se fijó FRAUDE_COOKIE_CSRF_NOMBRE en el backend. Por defecto: "__Host-csrf_token" con
# HTTPS en el mismo origen y "csrf_token" en desarrollo o con la API en otro origen.
# VITE_COOKIE_CSRF=

# Destino del proxy de desarrollo de Vite (solo servidor, no se expone al navegador).
API_PROXY_TARGET=http://127.0.0.1:8000
