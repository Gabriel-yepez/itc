# Copiar a .env y ajustar. Todas las variables llevan el prefijo FRAUDE_.
FRAUDE_ENTORNO=desarrollo
FRAUDE_URL_BASE_DATOS=sqlite:///./fraude.db
# PostgreSQL: FRAUDE_URL_BASE_DATOS=postgresql+psycopg://usuario:clave@host:5432/fraude

# Crea el administrador inicial solo si la BD no tiene usuarios (mínimo 12 caracteres recomendado).
FRAUDE_ADMIN_USUARIO=admin
FRAUDE_ADMIN_CONTRASENA=cambie-esta-clave-larga

# En desarrollo local sin HTTPS: false. En producción SIEMPRE true.
FRAUDE_COOKIE_SEGURA=false
FRAUDE_COOKIE_SAMESITE=strict
FRAUDE_SESION_MINUTOS_INACTIVIDAD=30
FRAUDE_SESION_HORAS_ABSOLUTAS=8
FRAUDE_MAX_INTENTOS_FALLIDOS=5
FRAUDE_MINUTOS_BLOQUEO=15

FRAUDE_ORIGENES_CORS=["http://localhost:5173"]
