# Copiar a .env y ajustar. Todas las variables llevan el prefijo FRAUDE_.
FRAUDE_ENTORNO=desarrollo

# --- PostgreSQL (docker compose up -d levanta uno en el puerto 5434) ---
FRAUDE_URL_BASE_DATOS=postgresql+psycopg://fraude:fraude_dev@localhost:5434/fraude
FRAUDE_BD_POOL_TAMANO=10
FRAUDE_BD_POOL_EXTRA=20
FRAUDE_BD_TIMEOUT_SENTENCIA_MS=30000
# Aplica las migraciones pendientes al arrancar. En producción puede ponerse en false
# y ejecutar `uv run alembic upgrade head` como paso del despliegue.
FRAUDE_MIGRAR_AL_INICIAR=true
# Base usada por `uv run pytest` (se BORRA en cada ejecución; su nombre debe contener "prueba").
FRAUDE_PRUEBAS_URL_BASE_DATOS=postgresql+psycopg://fraude:fraude_dev@localhost:5434/fraude_pruebas

# Variables de docker-compose.yml
POSTGRES_PUERTO=5434
POSTGRES_PASSWORD=fraude_dev

# Crea el administrador inicial solo si la BD no tiene usuarios (mínimo 12 caracteres recomendado).
FRAUDE_ADMIN_USUARIO=admin
FRAUDE_ADMIN_CONTRASENA=cambie-esta-clave-larga

# En desarrollo local sin HTTPS: false. En producción SIEMPRE true.
FRAUDE_COOKIE_SEGURA=false
FRAUDE_COOKIE_SAMESITE=strict
FRAUDE_SESION_MINUTOS_INACTIVIDAD=30
FRAUDE_SESION_HORAS_ABSOLUTAS=8
FRAUDE_MAX_INTENTOS_FALLIDOS=5
FRAUDE_MINUTOS_BLOQUEO=15

FRAUDE_ORIGENES_CORS=["http://localhost:5173"]
